# Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# NextAuth
# Generate a strong secret with: openssl rand -base64 32
# NEXTAUTH_URL should be your application's full production URL (e.g., https://yourapp.onrender.com)
NEXTAUTH_URL="http://localhost:3000" # Change for production
NEXTAUTH_SECRET=""

# Web Push Notifications (VAPID Keys)
# Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is exposed to the client-side
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Optional: Google OAuth (if you were to add it)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Add any other environment variables your application might need
# For example, if you integrate with a file storage service:
# S3_BUCKET_NAME=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
